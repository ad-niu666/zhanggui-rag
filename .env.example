# ============================================================
# 掌柜智库 RAG 知识库 —— 环境变量示例（.env.example）
# 复制本文件为 .env 后，填入你自己的真实值。.env 已被 .gitignore 忽略，不会上传。
# ============================================================

# ---------- MinerU 文档解析 ----------
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
# 本地模型缓存路径（按你机器实际情况改）
MODELSCOPE_CACHE=你的模型缓存路径，例如 D:/ai_models/modelscope_cache
HF_HOME=你的 huggingface 缓存路径
MD_ROOT_DIR=./temp-files/

# ---------- 大模型 API（阿里云百炼 / 通义千问，OpenAI 兼容模式） ----------
# api_key 申请地址：https://bailian.console.aliyun.com/
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
# ↓↓↓ 在此填写你的 DashScope / 通义千问 API Key ↓↓↓
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# ---------- Embedding 模型（本地模型，魔搭下载） ----------
BGE_M3_PATH=本地 bge-m3 模型路径
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
ITEM_NAME_DIAG=1

# ---------- Milvus 配置 ----------
# 切换成你 milvus 的 url 地址
MILVUS_URL=http://你的Milvus地址:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024

# ---------- Neo4j 配置（如果已启动的话） ----------
NEO4J_URI=bolt://你的Neo4j地址:7687
NEO4J_DATABASE=neo4j # 社区版不支持多数据库
NEO4J_USERNAME=neo4j
# ↓↓↓ 在此填写你的 Neo4j 密码 ↓↓↓
NEO4J_PASSWORD=your_neo4j_password

# ---------- MongoDB 配置 ----------
MONGO_URL=mongodb://你的MongoDB地址:27017
MONGO_DB_NAME=kb002

# ---------- MinIO 客户端 ----------
MINIO_ENDPOINT=你的MinIO地址:9000
# ↓↓↓ 在此填写你的 MinIO 访问 / 私有密钥 ↓↓↓
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ---------- 重排序模型配置 ----------
BGE_RERANKER_LARGE=本地 bge-reranker-large 模型路径
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ---------- 联网检索 MCP ----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ---------- MinerU API 及 URL ----------
# ↓↓↓ 在此填写你的 MinerU API Token ↓↓↓
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ---------- 日志配置 ----------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
